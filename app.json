{
  "expo": {
    "name": "Riven",
    "slug": "riven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valtheron.riven",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Riven uses your precise location only while the app is open to show you compatible people nearby. Your location is never shared without your explicit consent.",
        "NSCameraUsageDescription": "Riven uses your camera to take profile photos and complete identity verification. Photos are only uploaded when you choose to share them.",
        "NSPhotoLibraryUsageDescription": "Riven accesses your photo library so you can choose profile pictures to upload. No photos are accessed without your selection.",
        "NSPhotoLibraryAddUsageDescription": "Riven saves verification or profile photos to your library only when you request it.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {}
        }
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.valtheron.riven.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-1024.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.valtheron.riven",
      "usesCleartextTraffic": false,
      "newArchEnabled": true
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0D0D0F"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "riven",
    "experiments": {
      "typedRoutes": true,
      "newArchEnabled": true
    },
    "extra": {
      "router": {},
      "oneSignalAppId": "9135199d-954a-4172-aa70-cb899ecf2b32",
      "revenueCatApiKeyIos": "appl_mteJTZDNgRuNkLUuUSoLnzRWvDV",
      "revenueCatApiKeyAndroid": "goog_KeHOHSIFBZzAlHlYlSdWBFMFlIy"
    }
  }
}