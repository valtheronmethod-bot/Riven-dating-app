{
  "expo": {
    "name": "Riven",
    "slug": "riven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/55.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/55.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riven.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.riven.app.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/55.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.riven.app"
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "riven",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "oneSignalAppId": "9135199d-954a-4172-aa70-cb899ecf2b32"
    }
  }
}